[Unit]
Description=wechat-parser article auto collector
After=network.target

[Service]
Type=simple
User=lin
Group=lin
WorkingDirectory=/home/lin/projects/wechat-parser
ExecStart=/home/lin/.local/bin/uv run python wechat_article_auto_collect.py --interval 900 --wait-after-click 30
Restart=always
RestartSec=10

[Install]
WantedBy=multi-user.target
